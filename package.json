{
  "name": "@liamlangli/ui",
  "version": "0.0.1",
  "description": "Immediate-mode WebGPU UI toolkit: renderer, widgets, docking layout, and theming.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
