    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "assets"
  ],
  "peerDependencies": {
    "@webgpu/types": "^0.1.69"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}
