{
  "name": "@liamlangli/ui",
  "version": "0.0.1",
  "description": "Immediate-mode WebGPU UI toolkit: renderer, widgets, docking layout, and theming.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "wasm:box3d": "./scripts/build_box3d_wasm.sh",
    "test:physics": "node scripts/test_box3d_wasm.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./plugins": {
      "types": "./src/plugins/index.ts",
      "default": "./src/plugins/index.ts"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "default": "./src/storage/index.ts"
    },
    "./physics": {
      "types": "./src/physics/index.ts",
      "default": "./src/physics/index.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "assets",
    "native/box3d/LICENSE.box3d"
  ],
  "peerDependencies": {
    "@webgpu/types": "^0.1.69"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
